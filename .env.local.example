# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real values.

# From https://claude.ai/settings/account -> copy the Organization ID (UUID)
CLAUDE_ORG_ID=

# No CLAUDE_COOKIE needed: claude_export_cdp.py drives a real, already-logged-in
# Chrome tab over the DevTools Protocol, so the browser supplies auth itself.

# --- council_bot.py -----------------------------------------------------
# Telegram bot token from @BotFather (t.me/BotFather), and the chat_id of the
# person allowed to talk to it (only messages from this chat are answered).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: ntfy.sh push notifications for received/heartbeat/failed/sent
# events. Defaults to the same topic Claude Code's own hooks use (see
# ~/.claude/settings.json) -- only set these to point elsewhere, or set
# NTFY_TOPIC= (empty) to disable pushes entirely.
NTFY_TOPIC=
NTFY_BASE=
